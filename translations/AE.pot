"the difference that they are more deadly and that they will hurt themselves "
"even more."
msgstr ""

#. [unit_type], id=AE_mrc_enchanters_Devilhand, race=AE_mrc_enchanters_race
#: ./units/ME_units/enchanters/c3-devilhand.cfg:5
