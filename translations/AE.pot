#: ./units/EoMa_units/Barbarians/Cyclops_Breaker.cfg:18
msgid "Dauntless, +5 HP +20% max XP"
msgstr ""

#. [advancement], id=GOB_WB_MOV
#: ./units/EoMa_units/Barbarians/Cyclops_Breaker.cfg:50
