#. [unit_type], id=AE_mag_Pain_Sphere, race=mechanical
#: ./units/EoMa_units/Tharis/Matriarch_of_Pain.cfg:37
#: ./units/EoMa_units/Tharis/Pain_Sphere.cfg:4
