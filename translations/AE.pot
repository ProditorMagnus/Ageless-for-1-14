msgstr ""

#. [unit_type], id=AE_stf_eltireans_Dawnbringer, race=AE_stf_eltireans_race, gender=female
#. [unit_type], id=AE_stf_eltireans_Disciple_of_Eltire, race=AE_stf_eltireans_race, gender=female
