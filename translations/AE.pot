msgid "Vapor"
msgstr ""

#. [unit_type], id=AE_arc_phantom_Vapor, race=AE_arc_race_phantom_egypt
#: ./units/archaic_units/phantom/Tomb_Shade.cfg:84
msgid ""
"The Vapor can take the form of a real fighter, but the deception is apparent "
"when the opponent attacks and the vapor dissipates.\n"
"Special Note:  The phantom generated from this unit will die when struck by "
"an attacker, regardless of hitpoints."
msgstr ""

#. [unit_type], id=AE_arc_phantom_Tomb_Shield_Guard, race=AE_arc_race_phantom_egypt
#: ./units/archaic_units/phantom/Tomb_Shield.cfg:4
