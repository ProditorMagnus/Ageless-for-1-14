#: ./units/misc_units/steelhive/larva.cfg:12
msgid ""
"This unassuming little robot may not even have much in the way of legs, but "
"it is destined for great things. At this stage in its development, its more "
"at home in water than on land."
msgstr ""

#. [unit_type], id=AE_agl_steelhive_Lightshifter, race=AE_agl_steelhive, gender=female
#: ./units/misc_units/steelhive/lightshifter.cfg:7
