msgstr ""

#. [unit_type], id=AE_mrc_cult_Waylayer, race=AE_mrc_cult_race, gender=male
#: ./units/ME_units/cult/h3-waylayer.cfg:5
msgid "Waylayer"
msgstr ""

#. [unit_type], id=AE_mrc_emperors_guard_Martial_Artist, race=AE_mrc_emperors_guard_race, gender=male
#: ./units/ME_units/emperors_guard/a1-martial_artist.cfg:5
