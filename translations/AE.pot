msgid "rope"
msgstr ""

#. [attack], type=pierce, range=ranged
#: ./units/archaic_units/south-seas/Salvager.cfg:55
msgid "barb"
msgstr ""

#. [unit_type], id=AE_arc_south_seas_Sea_Scourge, race=AE_arc_race_south_seas_human, gender=female
#: ./units/archaic_units/south-seas/Scourge.cfg:4
msgid "female^Sea-Scourge"
msgstr ""

#. [attack], type=arcane, range=ranged
#: ./units/archaic_units/south-seas/Scourge.cfg:57
#: ./units/archaic_units/south-seas/Seahag.cfg:51
